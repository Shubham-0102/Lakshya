# Copy to .env (git ignores it):  cp .env.example .env
# Docker Compose and the Python packages both read .env.

# Postgres container. Host port 5433 so it doesn't clash with a local Postgres on 5432.
POSTGRES_USER=lakshya
POSTGRES_PASSWORD=lakshya-dev-password
POSTGRES_DB=lakshya
POSTGRES_PORT=5433

# Redis container. Host port 6380 so it doesn't clash with a local Redis on 6379.
REDIS_PORT=6380

# Connection URLs used by the backend and scraper (must match the values above)
DATABASE_URL=postgresql+psycopg://lakshya:lakshya-dev-password@localhost:5433/lakshya
TEST_DATABASE_URL=postgresql+psycopg://lakshya:lakshya-dev-password@localhost:5433/lakshya_test
REDIS_URL=redis://localhost:6380/0
